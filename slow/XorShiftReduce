#include <stdio.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include <time.h>

typedef uint8_t  u8;
typedef uint32_t u32;

#define FILE_PATH   "C:/Users/lukac/Documents/compressor/chunk2.bin"
#define OUT_PATH    "C:/Users/lukac/Documents/compressor/out.bin"
#define MAX_K       64
#define MAX_ROUNDS  64

/* float table — 16KB vs 32KB for double, fits cleanly in L1 */
static float hlogf[4097];

void init_hlog(int n) {
    hlogf[0] = 0.0f;
    for (int k = 1; k <= n; k++) hlogf[k] = k * log2f((float)k);
}

double entropy_freq(int *freq, int n) {
    double s = 0.0;
    for (int i = 0; i < 256; i++) if (freq[i]) s += hlogf[freq[i]];
    return log2((double)n) - s / n;
}

void apply_pattern(u8 *data, int n, u8 *pat, int K) {
    for (int i = 0; i < n; i++) data[i] ^= pat[i % K];
}

double find_best_analytic(u8 *data, int n, u8 *best_pat, int *best_K) {
    int freq0[256] = {0};
    for (int i = 0; i < n; i++) freq0[data[i]]++;
    double H0 = entropy_freq(freq0, n);

    double overall_net = 0.0;
    *best_K = 0;

    const double logn = log2((double)n);

    for (int K = 2; K <= MAX_K; K++) {
        int sub[64][256];
        memset(sub, 0, sizeof(sub));
        for (int i = 0; i < n; i++) sub[i % K][data[i]]++;

        u8  nz_val[64][256]; int nz_cnt[64];
        for (int p = 0; p < K; p++) {
            nz_cnt[p] = 0;
            for (int v = 0; v < 256; v++)
                if (sub[p][v]) nz_val[p][nz_cnt[p]++] = (u8)v;
        }

        u8 pat[64] = {0};

        int full[256] = {0};
        for (int p = 0; p < K; p++)
            for (int j = 0; j < nz_cnt[p]; j++)
                full[nz_val[p][j] ^ pat[p]] += sub[p][nz_val[p][j]];

        double full_hsum = 0.0;
        for (int v = 0; v < 256; v++) if (full[v]) full_hsum += hlogf[full[v]];
        double best_H = logn - full_hsum / n;

        int    base[256];
        int    bperm[256];        /* base[v^xp] precomputed for current j */
        float  delta_j[4097];     /* delta_j[b] = hlogf[b+sp]-hlogf[b], tiny range */
        float  delta_perm[256];   /* delta_j mapped through bperm */
        float  hsum_arr[256];     /* per-xp accumulator */

        for (int pass = 0; pass < 8; pass++) {
            int changed = 0;
            for (int p = (pass == 0 ? 1 : 0); p < K; p++) {
                int nc    = nz_cnt[p];
                u8  old_x = pat[p];

                /* base[] = full[] minus phase p — O(256) memcpy + O(nc) subtract */
                memcpy(base, full, 256 * sizeof(int));
                for (int j = 0; j < nc; j++)
                    base[nz_val[p][j] ^ old_x] -= sub[p][nz_val[p][j]];

                /* base_hsum in O(nc) */
                double base_hsum = full_hsum;
                for (int j = 0; j < nc; j++) {
                    int v = nz_val[p][j], sp = sub[p][v], fw = full[v ^ old_x];
                    base_hsum += hlogf[fw - sp] - hlogf[fw];
                }

                /* max base value — determines how many delta_j entries we need */
                int max_bw = 0;
                for (int w = 0; w < 256; w++) if (base[w] > max_bw) max_bw = base[w];

                /* init per-xp accumulators */
                float fbase = (float)base_hsum;
                for (int xp = 0; xp < 256; xp++) hsum_arr[xp] = fbase;

                for (int j = 0; j < nc; j++) {
                    int v  = nz_val[p][j];
                    int sp = sub[p][v];
                    /* tiny delta table — only max_bw+1 entries (~32-64 for large K) */
                    for (int b = 0; b <= max_bw; b++)
                        delta_j[b] = hlogf[b + sp] - hlogf[b];
                    /* gather base[v^xp] → bperm (1KB base[], L1 hot) */
                    for (int xp = 0; xp < 256; xp++) bperm[xp] = base[v ^ xp];
                    /* gather through tiny delta_j — fits in a few cache lines */
                    for (int xp = 0; xp < 256; xp++) delta_perm[xp] = delta_j[bperm[xp]];
                    /* sequential add — fully vectorized by compiler */
                    for (int xp = 0; xp < 256; xp++) hsum_arr[xp] += delta_perm[xp];
                }

                /* find best xp */
                double lbest_H = 1e18; u8 lbest_x = old_x;
                for (int xp = 0; xp < 256; xp++) {
                    double H = logn - hsum_arr[xp] / n;
                    if (H < lbest_H) { lbest_H = H; lbest_x = (u8)xp; }
                }

                if (lbest_x != old_x) {
                    for (int j = 0; j < nc; j++) {
                        int v = nz_val[p][j], sp = sub[p][v];
                        int wo = v ^ old_x;
                        full_hsum += hlogf[full[wo] - sp] - hlogf[full[wo]];
                        full[wo] -= sp;
                        int wn = v ^ lbest_x;
                        full_hsum += hlogf[full[wn] + sp] - hlogf[full[wn]];
                        full[wn] += sp;
                    }
                    pat[p] = lbest_x; best_H = lbest_H; changed = 1;
                }
            }
            if (!changed) break;
        }

        double raw = (H0 - best_H) * n;
        double key = 8.0 * K + 4.0;
        double net = raw - key;

        if (net > overall_net) {
            overall_net = net;
            *best_K     = K;
            memcpy(best_pat, pat, K);
        }
    }

    return overall_net;
}

int main() {
    FILE *f = fopen(FILE_PATH, "rb");
    if (!f) { fprintf(stderr, "cannot open %s\n", FILE_PATH); return 1; }
    fseek(f, 0, SEEK_END); int n = (int)ftell(f); rewind(f);
    u8 *data = malloc(n);
    fread(data, 1, n, f); fclose(f);
    init_hlog(n);

    int freq0[256] = {0};
    for (int i = 0; i < n; i++) freq0[data[i]]++;
    double H0 = entropy_freq(freq0, n);
    printf("original entropy : %.6f bpb  (%.1f bits total)\n\n", H0, H0*n);

    clock_t t0 = clock();
    double total_net = 0.0;
    int    total_key = 0;

    for (int round = 0; round < MAX_ROUNDS; round++) {
        u8  best_pat[64];
        int best_K;
        double net = find_best_analytic(data, n, best_pat, &best_K);

        if (net <= 0.0) {
            printf("round %d: no improvement (net=%.1f) — stopping\n", round+1, net);
            break;
        }

        apply_pattern(data, n, best_pat, best_K);

        int freq[256] = {0};
        for (int i = 0; i < n; i++) freq[data[i]]++;
        double H = entropy_freq(freq, n);

        int key_bits = 8 * best_K + 4;
        total_net += net;
        total_key += key_bits;

        printf("round %-2d  K=%-2d  H=%.6f  net=%+.1f  total=%+.1f bits\n",
               round+1, best_K, H, net, total_net);
    }

    printf("\ntotal net gain : %.1f bits\n", total_net);
    printf("total key cost : %d bits\n", total_key);
    printf("time           : %.3f s\n", (double)(clock()-t0)/CLOCKS_PER_SEC);

    FILE *fo = fopen(OUT_PATH, "wb");
    fwrite(data, 1, n, fo); fclose(fo);

    free(data);
    return 0;
}
