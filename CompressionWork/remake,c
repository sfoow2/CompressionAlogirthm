#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>
#include <math.h>
#include <omp.h>

typedef uint8_t  u8;
typedef uint64_t u64;

/* ---- disparity-controlled PRNG ------------------------------------ */
/* thresh=0 → pure LCG (no balance constraint)                        */
/* thresh>0 → force a corrective bit when imbalance exceeds threshold */

typedef struct { u64 state; int disp; } DispGen;

static inline int disp_next_t(DispGen *g, int thresh) {
    g->state = g->state * 6364136223846793005ULL + 1442695040888963407ULL;
    int b = (int)((g->state >> 33) & 1);
    if (thresh > 0) {
        if (g->disp >=  thresh) b = 0;
        if (g->disp <= -thresh) b = 1;
    }
    g->disp += b ? 1 : -1;
    return b;
}

/* thresholds to try during the search phase — 0 = pure LCG          */
/* the winner gets hardcoded; nothing extra is stored in the output   */
static const int THRESHOLDS[] = { 0, 1, 2, 3 };
#define N_THRESH (int)(sizeof(THRESHOLDS)/sizeof(THRESHOLDS[0]))
/* ------------------------------------------------------------------ */

static float lowerBitsEntropy(const u8 *d, int n) {
    int freq[128] = {0};
    for (int i = 0; i < n; i++) freq[d[i] & 0x7F]++;
    double e = 0.0;
    for (int i = 0; i < 128; i++) {
        if (!freq[i]) continue;
        double p = (double)freq[i] / n;
        e -= p * log2(p);
    }
    return (float)e;
}

static float byteEntropy(const u8 *d, int n) {
    int freq[256] = {0};
    for (int i = 0; i < n; i++) freq[d[i]]++;
    double e = 0.0;
    for (int i = 0; i < 256; i++) {
        if (!freq[i]) continue;
        double p = (double)freq[i] / n;
        e -= p * log2(p);
    }
    return (float)e;
}

int main(int argc, char **argv) {
    const char *OUT_PATH = "C:/Users/lukac/Documents/compressor/transformed.bin";

    #define TARGET_MATCH 0.75

    int size = 4096;
    u8 *data = malloc(size);
    srand(17);
    for (int x = 0; x < size; x++){
        data[x] = rand() % 256;
    }
    
    printf("Original entropy = %.6f\n", byteEntropy(data, size));

    /* seed size — constant across passes since file size doesn't change */
    double gain    = TARGET_MATCH - 0.5;
    int SEED_BYTES = (int)ceil(gain * gain * 2.0 * size / log(256.0));
    if (SEED_BYTES < 8) SEED_BYTES = 8;

    int bits_len = (size + 7) / 8;
    u8 *bits     = malloc(bits_len);
    u8 *work     = malloc(size);
    memcpy(work, data, size);

    u8      **thresh_seeds  = malloc(N_THRESH * sizeof(u8 *));
    int64_t  *thresh_totals = malloc(N_THRESH * sizeof(int64_t));
    for (int ti = 0; ti < N_THRESH; ti++)
        thresh_seeds[ti] = malloc(SEED_BYTES);

    int   total_header = 0;
    float orig_entropy = byteEntropy(data, size);
    float prev_entropy = orig_entropy;

    int below_prev = 0;
    for (int i = 0; i < size; i++) if (data[i] < 128) below_prev++;

    for (int pass = 0; ; pass++) {
        /* build bitstream from current work buffer */
        memset(bits, 0, bits_len);
        for (int i = 0; i < size; i++) {
            if (work[i] < 128)
                bits[i / 8] |= (1 << (7 - (i % 8)));
        }

        /* brute-force: all thresholds x 256 seeds per segment — parallel over segments */
        memset(thresh_totals, 0, N_THRESH * sizeof(int64_t));
        #pragma omp parallel for schedule(static)
        for (int seg = 0; seg < SEED_BYTES; seg++) {
            int seg_start = (int)((int64_t)seg       * size / SEED_BYTES);
            int seg_end   = (int)((int64_t)(seg + 1) * size / SEED_BYTES);

            for (int ti = 0; ti < N_THRESH; ti++) {
                int thresh = THRESHOLDS[ti];
                int best_s = 0, best_m = -1;
                for (int s = 0; s < 256; s++) {
                    DispGen g = { (u64)s * 2654435761ULL + 1442695040888963407ULL, 0 };
                    int m = 0;
                    for (int i = seg_start; i < seg_end; i++) {
                        int sb = (bits[i / 8] >> (7 - (i % 8))) & 1;
                        if (disp_next_t(&g, thresh) == sb) m++;
                    }
                    if (m > best_m) { best_m = m; best_s = s; }
                }
                thresh_seeds[ti][seg] = (u8)best_s;
                #pragma omp atomic
                thresh_totals[ti]    += (int64_t)best_m;
            }
        }

        /* pick best threshold globally */
        int best_ti = 0;
        for (int ti = 1; ti < N_THRESH; ti++)
            if (thresh_totals[ti] > thresh_totals[best_ti]) best_ti = ti;

        /* apply transform in-place — each segment is independent */
        int best_thresh = THRESHOLDS[best_ti];
        #pragma omp parallel for schedule(static)
        for (int seg = 0; seg < SEED_BYTES; seg++) {
            int seg_start = (int)((int64_t)seg       * size / SEED_BYTES);
            int seg_end   = (int)((int64_t)(seg + 1) * size / SEED_BYTES);
            DispGen g = { (u64)thresh_seeds[best_ti][seg] * 2654435761ULL
                          + 1442695040888963407ULL, 0 };
            for (int i = seg_start; i < seg_end; i++) {
                if (disp_next_t(&g, best_thresh) == 1)
                    work[i] |= 0x80;
            }
        }

        int below = 0;
        for (int i = 0; i < size; i++) if (work[i] < 128) below++;

        float cur_entropy = byteEntropy(work, size);
        int   gain_bytes  = (int)((prev_entropy - cur_entropy) * size / 8.0f + 0.5f);
        int   pass_cost   = 1 + SEED_BYTES;
        int   net         = gain_bytes - pass_cost;

        total_header += pass_cost;

        if (gain_bytes <= pass_cost) {
            printf("Pass %-2d  gain: %4dB  header: %3d  net: %+5d  [stopped]\n",
                   pass + 1, gain_bytes, pass_cost, net);
            total_header -= pass_cost;
            break;
        }
        printf("Pass %-2d  gain: %4dB  header: %3d  net: %+5d\n",
               pass + 1, gain_bytes, pass_cost, net);
        prev_entropy = cur_entropy;
        below_prev = below;
    }

    int total_gain = (int)((orig_entropy - prev_entropy) * size / 8.0f + 0.5f);
    printf("\nTotal profit: %+d bytes  (header: %d)\n",
           total_gain - total_header, total_header);
    printf("Final entropy: %.6f  (was %.6f)\n", prev_entropy, orig_entropy);

    FILE *fout = fopen(OUT_PATH, "wb");
    if (fout) {
        fwrite(work, 1, size, fout);
        fclose(fout);
    } else {
        fprintf(stderr, "Cannot write %s\n", OUT_PATH);
    }

    for (int ti = 0; ti < N_THRESH; ti++) free(thresh_seeds[ti]);
    free(thresh_seeds);
    free(thresh_totals);
    free(bits);
    free(work);
    free(data);
    return 0;
}
