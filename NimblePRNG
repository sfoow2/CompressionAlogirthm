}
int decode_stream(const u8*in,int ilen,u8*out,int ocap){
    int ip=0,op=0;
    while(ip<ilen&&op<ocap){int consumed;u8 syms[BLOCK*2+4];int ns=decode_block(in+ip,ilen-ip,syms,&consumed);for(int i=0;i<ns&&op<ocap;i++)out[op++]=syms[i];ip+=consumed;}
    return op;
}

typedef struct{int cr,sw,hw,compressed_size;float ratio;}TuneResult;
TuneResult tune(const u8*data,int len){
    TuneResult best={CR_MIN,SW_MIN,HW_MIN,len*3,999.0f};
    u8*enc=(u8*)malloc(len*3+64);
    if(!enc)return best;
    for(int cr=CR_MIN;cr<=CR_MAX;cr++)
    for(int sw=SW_MIN;sw<=SW_MAX;sw+=SW_STEP)
    for(int hw=HW_MIN;hw<=HW_MAX;hw+=HW_STEP){
        G_CR=cr;G_SW=sw;G_HW=hw;build_table();
        int sz=encode_stream(data,len,enc,len*3+64);
        if(sz<best.compressed_size){best.cr=cr;best.sw=sw;best.hw=hw;best.compressed_size=sz;best.ratio=(float)sz/len;}
    }
    free(enc);return best;
}

int t2_compress(const u8*in,int ilen,u8*out,int ocap){
    TuneResult s=tune(in,ilen);
    G_CR=s.cr;G_SW=s.sw;G_HW=s.hw;build_table();
    int hlen=write_header(out,s.cr,s.sw,s.hw);
    int dlen=encode_stream(in,ilen,out+hlen,ocap-hlen);
    return hlen+dlen;
}

int t2_decompress(const u8*in,int ilen,u8*out,int ocap){
    if(ilen<HEADER_BYTES||in[0]!=MAGIC)return -1;
    int cr,sw,hw;read_header(in,&cr,&sw,&hw);
    G_CR=cr;G_SW=sw;G_HW=hw;build_table();
    return decode_stream(in+HEADER_BYTES,ilen-HEADER_BYTES,out,ocap);
}

/* ------------------------------------------------------------------ */
/*  Nibble-level transforms                                             */
/* ------------------------------------------------------------------ */

#define OP_XOR  0
#define OP_ADD  1
#define OP_ROL  2
#define OP_COUNT 3
static const char* const OP_NAMES[] = {"XOR","ADD","ROL"};

static inline u8 nib_rol(u8 v, int k) { k&=3; return (u8)(((v<<k)|(v>>(4-k)))&0xF); }
static inline u8 nib_ror(u8 v, int k) { return nib_rol(v,(4-k)&3); }

void transform_apply(u8 *buf, int len, int op, int operand) {
    for(int i=0;i<len;i++){
        u8 v=buf[i]&0xF;
        switch(op){
            case OP_XOR: v^=(u8)(operand&0xF); break;
            case OP_ADD: v=(v+operand)&0xF;    break;
            case OP_ROL: v=nib_rol(v,operand); break;
        }
        buf[i]=v;
    }
}
void transform_invert(u8 *buf, int len, int op, int operand) {
    for(int i=0;i<len;i++){
        u8 v=buf[i]&0xF;
        switch(op){
            case OP_XOR: v^=(u8)(operand&0xF);      break;
            case OP_ADD: v=(v-operand+16)&0xF;       break;
            case OP_ROL: v=nib_ror(v,operand);       break;
        }
        buf[i]=v;
    }
}

/* ------------------------------------------------------------------ */
/*  Chain layer bookkeeping                                             */
/* ------------------------------------------------------------------ */

#define CHAIN_MAGIC     0xCC
#define LAYER_COMPRESS  0
#define LAYER_TRANSFORM 1
#define MAX_LAYERS      32

typedef struct { u8 type; u8 op; u8 operand; } Layer;
typedef struct { int nlayers; Layer layers[MAX_LAYERS]; } Chain;

int chain_write_header(const Chain *c, u8 *out) {
    int p=0;
    out[p++]=CHAIN_MAGIC;
    out[p++]=(u8)c->nlayers;
    for(int i=0;i<c->nlayers;i++){
        out[p++]=c->layers[i].type;
        if(c->layers[i].type==LAYER_TRANSFORM){
            out[p++]=c->layers[i].op;
            out[p++]=c->layers[i].operand;
        }
    }
    return p;
}
int chain_read_header(const u8 *in, int ilen, Chain *c) {
    if(ilen<2||in[0]!=CHAIN_MAGIC)return -1;
    c->nlayers=in[1];
    if(c->nlayers>MAX_LAYERS)return -1;
    int p=2;
    for(int i=0;i<c->nlayers;i++){
        if(p>=ilen)return -1;
        c->layers[i].type=in[p++];
        if(c->layers[i].type==LAYER_TRANSFORM){
            if(p+1>=ilen)return -1;
            c->layers[i].op     =in[p++];
            c->layers[i].operand=in[p++];
        }
    }
    return p;
}

