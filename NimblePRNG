/*  chain_compress / chain_decompress                                   */
/* ------------------------------------------------------------------ */

int chain_compress(const u8 *in, int ilen, u8 *out, int ocap,
                   float min_gain_frac, int verbose)
{
    int bufcap=ilen*4+512;
    u8 *bufA=(u8*)malloc(bufcap);
    u8 *bufB=(u8*)malloc(bufcap);
    u8 *tmp =(u8*)malloc(bufcap);
    if(!bufA||!bufB||!tmp){free(bufA);free(bufB);free(tmp);return -1;}

    memcpy(bufA,in,ilen);
    int cur_len=ilen;
    u8 *cur=bufA, *nxt=bufB;
    Chain chain; chain.nlayers=0;

    if(verbose){
        printf("[compress] input: %d bytes, first 16: ",ilen);
        for(int i=0;i<ilen&&i<16;i++) printf("%d ",in[i]);
        printf("\n");
    }

    for(int iter=0; iter<MAX_LAYERS-1&&chain.nlayers<MAX_LAYERS-1; iter++){

        if(verbose) printf("[compress] --- iter %d, cur_len=%d ---\n",iter,cur_len);

        /* ---- Try straight compression ---- */
        int clen=t2_compress(cur,cur_len,tmp,bufcap);
        float gain=1.0f-(float)clen/cur_len;

        if(clen<cur_len && gain>=min_gain_frac){
            if(verbose) printf("[compress] COMPRESS %d→%d (%.1f%%) ACCEPTED\n",cur_len,clen,gain*100);
            chain.layers[chain.nlayers].type=LAYER_COMPRESS;
            chain.nlayers++;
            memcpy(nxt,tmp,clen);
            cur_len=clen;
            u8 *swap=cur; cur=nxt; nxt=swap;
            continue;
        }

        /* ---- Try transform + compress ---- */
        int best_total=cur_len, best_op=-1, best_k=0;

        for(int k=1;k<16;k++){
            memcpy(nxt,cur,cur_len);
            transform_apply(nxt,cur_len,OP_XOR,k);
            int sz=t2_compress(nxt,cur_len,tmp,bufcap);
            if(sz<best_total){best_total=sz;best_op=OP_XOR;best_k=k;}
        }
        for(int k=1;k<16;k++){
            memcpy(nxt,cur,cur_len);
            transform_apply(nxt,cur_len,OP_ADD,k);
            int sz=t2_compress(nxt,cur_len,tmp,bufcap);
            if(sz<best_total){best_total=sz;best_op=OP_ADD;best_k=k;}
        }
        for(int k=1;k<=3;k++){
            memcpy(nxt,cur,cur_len);
            transform_apply(nxt,cur_len,OP_ROL,k);
            int sz=t2_compress(nxt,cur_len,tmp,bufcap);
            if(sz<best_total){best_total=sz;best_op=OP_ROL;best_k=k;}
        }

        float tgain=1.0f-(float)best_total/cur_len;
        if(best_op>=0 && tgain>=min_gain_frac && chain.nlayers+2<=MAX_LAYERS){
            if(verbose)
                printf("[compress] TRANSFORM(%s %d) + COMPRESS %d→%d (%.1f%%) ACCEPTED\n",
                       OP_NAMES[best_op],best_k,cur_len,best_total,tgain*100);

            /* Apply transform into nxt, compress nxt→tmp */
            memcpy(nxt,cur,cur_len);
            transform_apply(nxt,cur_len,best_op,best_k);
            int best_clen=t2_compress(nxt,cur_len,tmp,bufcap);

            chain.layers[chain.nlayers].type   =LAYER_TRANSFORM;
            chain.layers[chain.nlayers].op     =(u8)best_op;
            chain.layers[chain.nlayers].operand=(u8)best_k;
            chain.nlayers++;
            chain.layers[chain.nlayers].type=LAYER_COMPRESS;
            chain.nlayers++;

            /*
             * BUG FIX 2: The original code did memcpy(cur, tmp, ...) and
             * never swapped, which corrupted state on subsequent iterations
             * because nxt still held the transformed (not compressed) data.
             * Fix: always advance through nxt and swap, just like the
             * compress-only path.
             */
            memcpy(nxt,tmp,best_clen); /* nxt <- compressed result */
            cur_len=best_clen;
            u8 *swap=cur; cur=nxt; nxt=swap;
            continue;
        }

        if(verbose) printf("[compress] no further reduction at layer %d\n",chain.nlayers);
        break;
    }

    u8 hdr[MAX_LAYERS*3+4];
    int hlen=chain_write_header(&chain,hdr);
    int total=hlen+cur_len;
    if(total>ocap){free(bufA);free(bufB);free(tmp);return -1;}
    memcpy(out,hdr,hlen);
    memcpy(out+hlen,cur,cur_len);

    if(verbose){
        printf("[compress] DONE: %d layers, %d bytes (%.1f%% of input)\n",
               chain.nlayers,total,100.0f*total/ilen);
        for(int i=0;i<chain.nlayers;i++){
            if(chain.layers[i].type==LAYER_COMPRESS)
                printf("[compress]   [%d] COMPRESS\n",i);
            else
                printf("[compress]   [%d] TRANSFORM op=%s operand=%d\n",
                       i,OP_NAMES[chain.layers[i].op],chain.layers[i].operand);
        }
    }
    free(bufA);free(bufB);free(tmp);
    return total;
}

int chain_decompress(const u8 *in, int ilen, u8 *out, int ocap, int verbose)
{
    if(verbose) printf("[decomp] input: %d bytes\n",ilen);

    Chain chain;
    int hlen=chain_read_header(in,ilen,&chain);
    if(hlen<0){if(verbose)printf("[decomp] ERROR: bad header\n");return -1;}

    if(verbose){
        printf("[decomp] %d layers, payload %d bytes\n",chain.nlayers,ilen-hlen);
        for(int i=0;i<chain.nlayers;i++){
            if(chain.layers[i].type==LAYER_COMPRESS)
                printf("[decomp]   [%d] COMPRESS\n",i);
            else
                printf("[decomp]   [%d] TRANSFORM op=%s operand=%d\n",
                       i,OP_NAMES[chain.layers[i].op],chain.layers[i].operand);
        }
    }

    int pay_len=ilen-hlen;
    if(pay_len<0){if(verbose)printf("[decomp] ERROR: negative payload\n");return -1;}

    int bufcap=(ocap+pay_len)*4+512;
    u8 *bufA=(u8*)malloc(bufcap);
    u8 *bufB=(u8*)malloc(bufcap);
    if(!bufA||!bufB){free(bufA);free(bufB);return -1;}

    memcpy(bufA,in+hlen,pay_len);
    int cur_len=pay_len;
    u8 *cur=bufA, *nxt=bufB;

    for(int i=chain.nlayers-1;i>=0;i--){
        Layer *L=&chain.layers[i];
        if(L->type==LAYER_COMPRESS){
            if(cur_len<HEADER_BYTES||cur[0]!=MAGIC){
                if(verbose)printf("[decomp] ERROR: expected MAGIC at layer %d\n",i);
                free(bufA);free(bufB);return -1;
            }
            int dlen=t2_decompress(cur,cur_len,nxt,bufcap);
            if(dlen<0){
                if(verbose)printf("[decomp] ERROR: t2_decompress failed at layer %d\n",i);
                free(bufA);free(bufB);return -1;
            }
            if(verbose) printf("[decomp] layer %d COMPRESS: %d→%d bytes\n",i,cur_len,dlen);
            cur_len=dlen;
            u8 *swap=cur; cur=nxt; nxt=swap;
        } else {
            if(verbose) printf("[decomp] layer %d TRANSFORM inv(%s %d) on %d bytes\n",
                               i,OP_NAMES[L->op],L->operand,cur_len);
            transform_invert(cur,cur_len,L->op,L->operand);
        }
    }

    if(cur_len>ocap){
        if(verbose)printf("[decomp] ERROR: output %d exceeds ocap %d\n",cur_len,ocap);
        free(bufA);free(bufB);return -1;
    }
    memcpy(out,cur,cur_len);
    if(verbose) printf("[decomp] DONE: %d bytes recovered\n",cur_len);
    free(bufA);free(bufB);
    return cur_len;
}

