#define MAGIC        0xC0
#define CR_MIN   1
#define CR_MAX   7
#define SW_MIN   5
#define SW_MAX  80
#define SW_STEP  5
#define HW_MIN   0
#define HW_MAX  40
#define HW_STEP  5
#define HEADER_BYTES 3

u16 pack_settings(int cr, int sw, int hw) {
    return (u16)(((cr-CR_MIN)<<13)|((sw-SW_MIN)/SW_STEP<<9)|((hw-HW_MIN)/HW_STEP<<5));
}
void unpack_settings(u16 p, int *cr, int *sw, int *hw) {
    *cr = ((p>>13)&0x07)+CR_MIN;
    *sw = ((p>> 9)&0x0F)*SW_STEP+SW_MIN;
    *hw = ((p>> 5)&0x0F)*HW_STEP+HW_MIN;
}
int write_header(u8 *out, int cr, int sw, int hw) {
    u16 p = pack_settings(cr,sw,hw);
    out[0]=MAGIC; out[1]=(u8)(p>>8); out[2]=(u8)(p&0xFF);
    return HEADER_BYTES;
}
int read_header(const u8 *in, int *cr, int *sw, int *hw) {
    if (in[0]!=MAGIC) return 0;
    unpack_settings(((u16)in[1]<<8)|in[2], cr, sw, hw);
    return 1;
}

static int G_CR=24, G_SW=40, G_HW=15;
#define HISTORY_LEN 4
typedef struct { u32 lcg; u8 last; u8 history[HISTORY_LEN]; int hpos; u32 bias[16]; } NibblePRNG;
static NibblePRNG g_nib;

static inline u32 lcg_step(u32 *s, u8 fb) { *s=*s*1664525u+1013904223u+(u32)fb; return *s; }

void nibble_seed_g(NibblePRNG *m, u8 seed) {
    m->lcg=(u32)seed*2654435761u^0xDEADBEEFu;
    m->last=seed&0x0F; m->hpos=0;
    memset(m->history,m->last,sizeof(m->history));
}
u8 nibble_next_g(NibblePRNG *m) {
    int CR=G_CR, SW=G_SW, HW=G_HW;
    for(int i=0;i<16;i++) m->bias[i]=(lcg_step(&m->lcg,m->last)>>16)&0xFF;
    for(int d=-CR;d<=CR;d++){int idx=((int)m->last+d+16)&0x0F,dist=d<0?-d:d;if(dist<=CR)m->bias[idx]+=(u32)(CR-dist+1)*3u;}
    m->bias[m->last]+=(u32)SW;
    for(int h=0;h<HISTORY_LEN;h++) m->bias[m->history[h]]+=(u32)HW;
    u64 total=0; for(int i=0;i<16;i++) total+=m->bias[i];
    u64 r=((u64)(lcg_step(&m->lcg,m->last)>>8)<<16)|(lcg_step(&m->lcg,m->last)>>16);
    u8 out=0; u64 acc=0;
    for(int i=0;i<16;i++){acc+=m->bias[i];if((r%total)<acc){out=(u8)i;break;}}
    m->history[m->hpos]=m->last; m->hpos=(m->hpos+1)%HISTORY_LEN; m->last=out;
    return out;
}

#define NSEEDS  16
#define WINDOW4  4
/*
 * BUG FIX 1: BLOCK reduced from 8 to 7.
 *
 * encode_block uses 0xFF as a sentinel for the "store raw" fallback path.
 * With BLOCK=8 slots, flags occupies 8 bits — so a fully-compressed block
 * produces flags=0b11111111=0xFF, which the decoder mistakes for a raw block.
 * With BLOCK=7, flags bits 0..6 are used and bit 7 is always 0, so flags
 * can never reach 0xFF naturally. The sentinel is now unambiguous.
 */
#define BLOCK    7

static int enc_seed[16][16], enc_offset[16][16];
void build_table(void) {
    for(int a=0;a<16;a++) for(int b=0;b<16;b++) enc_seed[a][b]=-1;
    for(int s=0;s<NSEEDS;s++){
        nibble_seed_g(&g_nib,(u8)s);
        u8 a=nibble_next_g(&g_nib);
        for(int w=0;w<WINDOW4;w++){u8 b=nibble_next_g(&g_nib);if(enc_seed[a][b]==-1){enc_seed[a][b]=s;enc_offset[a][b]=w;}}
    }
}

typedef struct{u8*buf;int cap;int bp;}BS;
void bs_init(BS*b,u8*buf,int c){b->buf=buf;b->cap=c;b->bp=0;memset(buf,0,c);}
void bs_w(BS*b,u32 v,int n){for(int i=0;i<n;i++){int by=b->bp/8,bi=b->bp%8;if(by<b->cap&&((v>>i)&1))b->buf[by]|=(1u<<bi);b->bp++;}}
u32  bs_r(BS*b,int n){u32 v=0;for(int i=0;i<n;i++){int by=b->bp/8,bi=b->bp%8;if(by<b->cap&&((b->buf[by]>>bi)&1))v|=(1u<<i);b->bp++;}return v;}
int  bs_bytes(const BS*b){return(b->bp+7)/8;}

int encode_block(const u8*in,int count,u8*out,int*out_bits,int*in_used){
    u8 slot_comp[BLOCK],slot_seed[BLOCK],slot_off[BLOCK],slot_val[BLOCK];
    int nslots=0,syms_done=0;
    while(syms_done<count&&nslots<BLOCK){
        int a=in[syms_done]&0xF;
        if(syms_done+1<count){int b=in[syms_done+1]&0xF,s=enc_seed[a][b];if(s>=0){slot_comp[nslots]=1;slot_seed[nslots]=(u8)s;slot_off[nslots]=(u8)enc_offset[a][b];nslots++;syms_done+=2;continue;}}
        slot_comp[nslots]=0;slot_val[nslots]=(u8)(in[syms_done]&0xF);nslots++;syms_done++;
    }
    if(in_used)*in_used=syms_done;
    u8 flags=0; for(int i=0;i<nslots;i++) if(slot_comp[i]) flags|=(1u<<i);
    /* flags can never be 0xFF here because BLOCK<=7 means only bits 0..6 are used */
    u8 pbuf[12];memset(pbuf,0,12);BS pbs;bs_init(&pbs,pbuf,12);
    for(int i=0;i<nslots;i++){if(slot_comp[i]){bs_w(&pbs,slot_seed[i],4);bs_w(&pbs,slot_off[i],2);}else bs_w(&pbs,slot_val[i],4);}
    if(out_bits)*out_bits=pbs.bp;
    int total=2+bs_bytes(&pbs);
    if(total>=syms_done+1){out[0]=0xFF;out[1]=(u8)syms_done;for(int i=0;i<syms_done;i++)out[2+i]=in[i]&0xF;if(out_bits)*out_bits=-1;return 2+syms_done;}
    out[0]=flags;out[1]=(u8)nslots;memcpy(out+2,pbuf,bs_bytes(&pbs));return total;
}

int decode_block(const u8*in,int in_len,u8*out,int*consumed){
    if(in_len<2)return 0;
    if(in[0]==0xFF){int cnt=in[1];if(cnt>in_len-2)cnt=in_len-2;for(int i=0;i<cnt;i++)out[i]=in[2+i]&0xF;*consumed=2+cnt;return cnt;}
    u8 flags=in[0];int nslots=in[1];
    /* BUG FIX 3: guard against corrupt/oversized nslots */
    if(nslots>BLOCK){*consumed=2;return 0;}
    BS pbs;pbs.buf=(u8*)(in+2);pbs.cap=in_len-2;pbs.bp=0;int pos=0;
    for(int sl=0;sl<nslots;sl++){
        if((flags>>sl)&1){u8 seed=(u8)bs_r(&pbs,4);int off=(int)bs_r(&pbs,2);nibble_seed_g(&g_nib,seed);u8 a=nibble_next_g(&g_nib);for(int i=0;i<off;i++)nibble_next_g(&g_nib);u8 b=nibble_next_g(&g_nib);out[pos++]=a;out[pos++]=b;}
        else out[pos++]=(u8)bs_r(&pbs,4);
    }
    int bits=0;for(int sl=0;sl<nslots;sl++) bits+=((flags>>sl)&1)?6:4;
    *consumed=2+(bits+7)/8;return pos;
}
int encode_stream(const u8*in,int ilen,u8*out,int ocap){
    int ip=0,op=0;
    while(ip<ilen){int chunk=ilen-ip<BLOCK?ilen-ip:BLOCK;u8 blk[16];int in_used=0;int blen=encode_block(in+ip,chunk,blk,NULL,&in_used);if(op+blen>ocap)break;memcpy(out+op,blk,blen);op+=blen;ip+=in_used;}
