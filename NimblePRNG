void run_test(const char *name, const u8 *data, int len) {
    printf("\n========== %s (%d bytes) ==========\n",name,len);

    int ocap=len*8+512;
    u8 *comp=(u8*)malloc(ocap);
    u8 *dec =(u8*)malloc(ocap);
    if(!comp||!dec){printf("OOM\n");free(comp);free(dec);return;}

    int clen=chain_compress(data,len,comp,ocap,0.005f,1);
    if(clen<0){printf("compress failed\n");free(comp);free(dec);return;}
    printf("Compressed: %d → %d bytes (%.1f%%)\n",len,clen,100.0f*clen/len);

    int dlen=chain_decompress(comp,clen,dec,ocap,1);
    if(dlen<0){printf("decompress failed\n");free(comp);free(dec);return;}

    int ok=(dlen==len);
    if(ok) for(int i=0;i<len;i++) if((data[i]&0xF)!=(dec[i]&0xF)){ok=0;break;}

    if(!ok){
        printf("ROUND-TRIP MISMATCH (got %d bytes, expected %d)\n",dlen,len);
        printf("Input  nibbles: "); for(int i=0;i<16&&i<len;i++) printf("%X ",data[i]&0xF); printf("\n");
        printf("Output nibbles: "); for(int i=0;i<16&&i<dlen;i++) printf("%X ",dec[i]&0xF);  printf("\n");
    } else {
        printf("Round-trip: OK\n");
    }
    free(comp);free(dec);
}

